@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <style>
        .cnt-box.cnt-box-top.boxed .caption {
            height: 325px;
        }

        img.partners {
            max-width: 150px !important;
        }
    </style>
}

<section class="section-image section-home-one no-padding-y"
         style="background-image: url(/themekit/media/slider/hd-1.jpg)">
    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <hr class="space-lg" />
                <h3 class="text-color-2">
                    ACCELERATE YOUR BUSINESS
                </h3>
                <ul class="slider" data-options="arrows:true,nav:false,autoplay:3000,controls:out">
                    <li>
                        <h1 class="text-uppercase">Technology to power your business</h1>
                    </li>
                    <li>
                        <h1 class="text-uppercase">Empowering Talent Transformations</h1>
                    </li>
                    <li>
                        <h1 class="text-uppercase">Ideas that make an impact</h1>
                    </li>
                </ul>
                <p>
                    Our passionate team work with well-defined strategies and visions coupled
                    with many years of expertise leading to successful project completion and satisfaction.
                </p>
                <hr class="space-sm" />
                <a class="btn btn-sm width-190 full-width-sm" href="/contact-us">Contact us</a>
                <hr class="space-lg" />
                <hr class="space-lg" />
            </div>
            <div class="col-lg-5 hidden-md">
                <hr class="space-sm" />
                <img data-anima="fade-bottom" data-time="1000" class="slide-image" src="/themekit/media/slider/man-3.png" alt="" />
            </div>
        </div>
    </div>
</section>

<section class="section-base section-overflow-top">
    <div class="container">
        <div class="grid-list" data-columns="4" data-columns-md="2" data-columns-sm="1">
            <div class="grid-box">
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top-icon boxed">
                        <i class="im-monitor-phone"></i>
                        <div class="caption">
                            <h2>End to end application</h2>
                            <p>
                                From the development of new applications, through modernisation, management and maintenance, we cover all stages of the application lifecycle.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top-icon boxed">
                        <i class="im-bar-chart2"></i>
                        <div class="caption">
                            <h2>Data analytics</h2>
                            <p>
                                Data is the next fuel for society to turn the race of society to the next level.
                                City Tech Consultants delivers on simple and complex needs with tailored business analytics solutions.
                                <br />
                            </p>
                        </div>
                    </div>
                </div>
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top-icon boxed">
                        <i class=" im-map"></i>
                        <div class="caption">
                            <h2>Digital Transformation</h2>
                            <p>
                                Move your organisation forward by using digital technologies to rethink business processes, collaboration, and customer experiences.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top-icon boxed">
                        <i class="im-sync-cloud"></i>
                        <div class="caption">
                            <h2>Manage cloud-native apps</h2>
                            <p>
                                We guide your teams to modernise and streamline cloud-native app development with containers. Deliver apps faster and stay competitive.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row row-fit-lg" data-anima="fade-bottom" data-time="1000">
            <div class="col-lg-6">
                <ul class="slider" data-options="arrows:true,nav:false">
                    <li>
                        <img src="/themekit/media/office/office-1.jpg" alt="Office 1">
                    </li>
                    <li>
                        <img src="/themekit/media/office/office-2.jpg" alt="Office 2">
                    </li>
                    <li>
                        <img src="/themekit/media/office/office-3.jpg" alt="Office 3">
                    </li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="title">
                    <h2>Our values and goals</h2>
                    <p>About us</p>
                </div>
                <p>
                    City tech consultants are dedicated to the satisfaction of every client and are committed to
                    the highest standard of ethics, business conduct and company principles.
                </p>
                <p>
                    Thanks to our in-house expertise from the technically trained sales team to our corporate-class
                    engineers, CTC is here to help. We attract and develop the best talent for your business, share knowledge
                    and provide them with the necessary tools and resources to keep up with today’s fast changing environment.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section-base section-color">
    <div class="container">
        <div class="row" data-anima="fade-bottom" data-time="1000">
            <div class="col-lg-6">
                <div class="title">
                    <h2>We specialise in</h2>
                    <p>Our services</p>
                </div>
            </div>
        </div>
        <hr class="space" />
        <div class="grid-list pagination-top-right" data-columns="3" data-columns-md="2" data-columns-sm="1" data-anima="fade-bottom" data-time="1000">
            <div class="grid-box">
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top boxed">
                        <div class="caption">
                            <h2>APP DEVELOPMENT</h2>
                            <p>
                                We don’t just build apps. We help clients build the right apps, in the right way, for a maximum return on investment.
                            </p>
                            <a class="btn-text" href="/services/app-development">Learn more</a>
                        </div>
                    </div>
                </div>
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top boxed">
                        <div class="caption">
                            <h2>WEB DEVELOPMENT</h2>
                            <p>
                                Web development consulting provides comprehensive support and enhancement of web applications before, during and after development.
                            </p>
                            <a class="btn-text" href="/services/web-development">Learn more</a>
                        </div>
                    </div>
                </div>
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top boxed">
                        <div class="caption">
                            <h2>MAINTENANCE &amp; SUPPORT</h2>
                            <p>
                                Software maintenance is proactive and includes scheduled activities to address non-urgent issues or perform planned improvements.
                            </p>
                            <a class="btn-text" href="/services/maintainance-support">Learn more</a>
                        </div>
                    </div>
                </div>
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top boxed">
                        <div class="caption">
                            <h2>COST MANAGEMENT</h2>
                            <p>
                                A cost management service will allow clients to review comprehensive cost information reports which will help plan for future expenses and avoid budget overrun.
                            </p>
                            <a class="btn-text" href="/services/cost-management">Learn more</a>
                        </div>
                    </div>
                </div>
                <div class="grid-item">
                    <div class="cnt-box cnt-box-top boxed">
                        <div class="caption">
                            <h2>WARRANTY MANAGEMENT</h2>
                            <p>
                                We help product brands manage warranties efficiently, cut operational costs, build stronger customer data and grow after-sales revenue.
                            </p>
                            <a class="btn-text" href="/services/warranty-management">Learn more</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="list-pagination">
                <ul class="pagination" data-page-items="3" data-page-items-md="2" data-page-items-sm="1" data-pagination-anima="fade-bottom"></ul>
            </div>
        </div>
        <hr class="space" />
        <hr class="space-xs" />
    </div>
</section>

<section class="section-base section-overflow-top">
    <div class="container">
        <table class="table table-grid table-border align-left boxed-area table-6-md">
            <tbody>
                <tr>
                    <td>
                        <div class="counter counter-horizontal counter-icon">
                            <i class="im-globe text-md"></i>
                            <div>
                                <h3>Countries</h3>
                                <div class="value">
                                    <span class="text-md" data-to="4" data-speed="5000">4</span>
                                    <span>+</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="counter counter-horizontal counter-icon">
                            <i class="im-business-man text-md"></i>
                            <div>
                                <h3>Projects</h3>
                                <div class="value">
                                    <span class="text-md" data-to="4000" data-speed="5000">4000</span>
                                    <span>+</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="counter counter-horizontal counter-icon">
                            <i class="im-support text-md"></i>
                            <div>
                                <h3>Programmers</h3>
                                <div class="value">
                                    <span class="text-md" data-to="350" data-speed="5000">350</span>
                                    <span>+</span>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="title">
            <p>Clients &amp; Partners</p>
        </div>
    <ul class="slider section-full-width" data-options="type:carousel,arrows:true,nav:true,perView:5,perViewMd:3,perViewSm:3,controls:out">
        <li>
            <img class="partners" src="/images/partners/pepsi.png?v=2" alt="Pepsi">
        </li>
        <li>
            <img class="partners" src="/images/partners/tap1ce.png" alt="Tap1ce">
        </li>
        <li>
            <img class="partners" src="/images/partners/standford.png" alt="Stanford University">
        </li>
        <li>
            <img class="partners" src="/images/partners/mama-earth.png" alt="Mama Earth">
        </li>
        <li>
            <img class="partners" src="/images/partners/azure.png" alt="Microsoft Azure">
        </li>
        <li>
            <img class="partners" src="/images/partners/aws.png" alt="AWS">
        </li>
    </ul>
    </div>
</section>
